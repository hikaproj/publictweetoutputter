{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FxTwitterArchiveStudio",
  "version": "1.0.0",
  "identifier": "com.hikaproj.app.mobile.pubtweetoutputter",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FxTwitter Archive Studio - by Hikaproj",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Hikaproj. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Ultra-fast Twitter/X bulk post and media archive studio",
    "longDescription": "Ultra-fast Twitter/X bulk post and media archive studio powered by FxTwitter API with robust private-account recovery, media filters, and multi-format compression.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "16.1",
      "frameworks": [
        "ActivityKit",
        "WidgetKit",
        "SwiftUI"
      ]
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
